# [build]
#
# [build.git-example]
# git_path = "git@github:ajfabbri/automate-big-data.git"  # or local repo, e.g. "/home/code/foo"
# git_ref = "main"
#
# [build.tar-example]
# tar_path = "https://dist.apache.org/repos/dist/dev/hadoop/hadoop-3.5.0-RC2/hadoop-3.5.0.tar.gz"


#  _           _ _     _
# | |__  _   _(_) | __| |
# | '_ \| | | | | |/ _` |
# | |_) | |_| | | | (_| |
# |_.__/ \__,_|_|_|\__,_|
#
[build.hadoop]
# e.g. "git@github:user/foo.git"  # or local repo, e.g. "/home/user/code/foo"
git_path = "build/hadoop"
# If not set, will use "trunk".
# Use "HEAD" to use current checked out version of existing repository.
git_ref = "HEAD"

[build.cloudstore]
git_path = "build/cloudstore"

[build.spark]
tar_path="https://www.apache.org/dyn/closer.lua/spark/spark-4.1.1/spark-4.1.1-bin-without-hadoop.tgz"


#      _            _
#   __| | ___ _ __ | | ___  _   _
#  / _` |/ _ \ '_ \| |/ _ \| | | |
# | (_| |  __/ |_) | | (_) | |_| |
#  \__,_|\___| .__/|_|\___/ \__, |
#            |_|            |___/
[deploy.cluster_node]
image_name = "cluster-node"
num_nodes = 3
installs = [ { build_name = "hadoop", path = "/home/hadoop/"},
    { build_name = "cloudstore", path = "/home/hadoop/"} ]
